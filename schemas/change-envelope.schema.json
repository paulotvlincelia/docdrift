{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/gemma-doc-sync/change-envelope.schema.json",
  "title": "ChangeEnvelope",
  "description": "Versioned context passed to the documentation synchronizer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "repository",
    "trigger",
    "intent_artifacts",
    "decision_artifacts",
    "changes",
    "candidate_documents",
    "policy",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vcs", "base_revision", "target_revision", "languages"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "vcs": {"const": "git"},
        "base_revision": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "architecture_summary": {"type": "string"}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "source", "timestamp"],
      "properties": {
        "type": {
          "enum": [
            "requirement_changed",
            "adr_changed",
            "pull_request_opened",
            "pull_request_updated",
            "pull_request_merged",
            "commit_pushed",
            "release_candidate",
            "release_published",
            "manual"
          ]
        },
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "intent_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "decision_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "change_type", "diff"],
        "properties": {
          "kind": {
            "enum": ["code", "test", "schema", "configuration", "documentation"]
          },
          "path": {"type": "string", "minLength": 1},
          "change_type": {"enum": ["ADD", "MODIFY", "DELETE", "RENAME", "COPY"]},
          "diff": {"type": "string"},
          "symbols": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "candidate_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "document_type",
          "sha256_before",
          "content_before",
          "retrieval"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "document_type": {"$ref": "#/$defs/documentType"},
          "sha256_before": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_before": {"type": "string"},
          "retrieval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "methods"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "score": {"type": "number"},
              "methods": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "explicit_reference",
                    "path_rule",
                    "symbol",
                    "co_change",
                    "lexical",
                    "embedding",
                    "manual"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_evidence", "allowed_paths", "forbidden_paths"],
      "properties": {
        "require_evidence": {"type": "boolean"},
        "allowed_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "instructions": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "retrieval_strategy", "omitted_items"],
      "properties": {
        "truncated": {"type": "boolean"},
        "retrieval_strategy": {"type": "string", "minLength": 1},
        "omitted_items": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "status", "content"],
      "properties": {
        "kind": {"enum": ["requirement", "issue", "pull_request", "adr", "design_doc"]},
        "id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "content": {"type": "string"}
      }
    },
    "documentType": {
      "enum": [
        "readme",
        "architecture",
        "adr",
        "requirement",
        "api_reference",
        "runbook",
        "deployment",
        "security",
        "testing",
        "changelog",
        "user_guide",
        "other"
      ]
    }
  }
}
